# Copy to .env and fill in the three secrets. Never commit .env.

# Slack app: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Slack app: Basic Information -> App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=xapp-...
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Your meme channel's ID, e.g. C0123456789 (bottom of the channel's About tab). Comma-separate to add channels;
# leave blank for any channel the bot is invited to.
MEME_CHANNEL_IDS=
# Bank managers: only they can "forget" (remove) and "restore" memes; anyone else's forget asks them by DM. Your Slack
# member ID, e.g. U0123456789 (your profile -> ⋮ -> Copy member ID); comma-separate several. Leave blank and nobody
# can remove memes.
ADMIN_USER_IDS=
# thread = react with :bank: and reply in a thread with the tags; reaction = react only
ACK_MODE=thread
# React to any image post with one of these emoji to bank it
BANK_REACTIONS=bank
# on = after each new deposit, DM whoever banked it the full tag list and how to add more; off = don't
DM_TAGS=on

# Claude models for tagging images and for picking search results
TAG_MODEL=claude-sonnet-5-5
SEARCH_MODEL=claude-sonnet-5-5

# Where alerts go (restarts, errors, bot gone quiet). Leave blank for no alerts.
ALERT_EMAIL=

# local = SQLite + a folder (for trying it on your PC); the deploy script sets azure in the cloud
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./memebank-data
